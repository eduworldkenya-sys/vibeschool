{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vibeschool://repair/repair-packet-v1",
  "title": "Governed Repair Packet V1",
  "type": "object",
  "required": ["artifact", "finding", "author_lineage", "quality_lineage", "critic_lineage", "provenance", "constraints", "authorization"],
  "properties": {
    "artifact": {
      "type": "object",
      "required": ["artifact_id", "artifact_type", "version", "content", "content_sha256"],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1},
        "artifact_type": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "content": {"type": ["string", "object"]},
        "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "finding": {
      "type": "object",
      "required": ["finding_id", "critic_execution_id", "artifact_version", "category", "canonical_dimension", "severity", "affected_section", "claim", "evidence", "reasoning_summary", "required_remediation", "release_blocking", "confidence"],
      "properties": {
        "finding_id": {"type": "string", "minLength": 1},
        "critic_execution_id": {"type": "string", "minLength": 1},
        "artifact_version": {"type": "string", "minLength": 1},
        "category": {"type": "string", "minLength": 1},
        "canonical_dimension": {"type": "string", "minLength": 1},
        "severity": {"enum": ["CRITICAL", "MAJOR", "MODERATE", "MINOR", "NOTE"]},
        "affected_section": {"type": "string", "minLength": 1},
        "affected_curriculum_outcome": {"type": ["string", "null"]},
        "claim": {"type": "string", "minLength": 1},
        "evidence": {},
        "reasoning_summary": {"type": "string", "minLength": 1},
        "required_remediation": {"type": "string", "minLength": 1},
        "release_blocking": {"type": "boolean"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "uncertainty": {"type": ["string", "null"]}
      }
    },
    "author_lineage": {"type": "object"},
    "quality_lineage": {"type": "object"},
    "critic_lineage": {"type": "object"},
    "provenance": {
      "type": "object",
      "required": ["verified_sources", "semantic_verification_state"],
      "properties": {
        "verified_sources": {"type": "array"},
        "semantic_verification_state": {"type": "string"}
      }
    },
    "constraints": {
      "type": "object",
      "required": ["allowed_sections", "protected_sections", "preserve_curriculum_identity", "preserve_release_state"],
      "properties": {
        "allowed_sections": {"type": "array", "items": {"type": "string"}},
        "protected_sections": {"type": "array", "items": {"type": "string"}},
        "preserve_curriculum_identity": {"const": true},
        "preserve_release_state": {"const": true},
        "max_attempts": {"type": "integer", "minimum": 1, "maximum": 5}
      }
    },
    "authorization": {
      "type": "object",
      "required": ["authorized", "scope", "expires_at"],
      "properties": {
        "authorized": {"const": true},
        "scope": {"const": "repair_candidate_only"},
        "expires_at": {"type": "string", "minLength": 1}
      }
    },
    "prior_attempts": {"type": "array"}
  },
  "additionalProperties": true
}
