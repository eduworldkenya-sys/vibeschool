'use client'

import { useRouter } from 'next/navigation'
import { useStoryFeed } from '@/components/global/feed/useStoryFeed'
import { StoryFeedCard } from '@/components/global/feed/StoryFeedCard'

export default function GlobalPage() {
  const router = useRouter()
  const {
    stories,
    trending,
    loading,
    searchQuery,
    setSearchQuery,
    selectedAge,
    setSelectedAge,
    selectedLang,
    setSelectedLang,
    filteredStories,
  } = useStoryFeed()

  return (
    <div style={{ minHeight: '100dvh', backgroundColor: '#090D16', color: '#FFFFFF', padding: 24, fontFamily: 'sans-serif' }}>

      <header style={{ marginBottom: 32 }}>
        <h1 style={{ fontSize: 32, fontWeight: 800, color: '#CCFF00', marginBottom: 8 }}>VibeChronicles</h1>
        <p style={{ fontSize: 16, color: '#888899' }}>Discover and read interactive CBC stories from classrooms across Kenya.</p>
      </header>

      <div style={{ marginBottom: 24, display: 'flex', gap: 12, flexWrap: 'wrap' }}>
        <input
          type="text"
          placeholder="Search by title..."
          value={searchQuery}
          onChange={(e) => setSearchQuery(e.target.value)}
          style={{ backgroundColor: '#141B2D', border: '1px solid #24324D', borderRadius: 8, padding: 12, color: '#FFFFFF', minWidth: 240, fontSize: 14 }}
        />
        <select
          value={selectedAge}
          onChange={(e) => setSelectedAge(e.target.value)}
          style={{ backgroundColor: '#141B2D', border: '1px solid #24324D', borderRadius: 8, padding: 12, color: '#FFFFFF', fontSize: 14 }}
        >
          <option value="all">All Ages</option>
          <option value="4-8">Ages 4-8</option>
          <option value="9-11">Ages 9-11</option>
          <option value="12+">Ages 12+</option>
        </select>
        <select
          value={selectedLang}
          onChange={(e) => setSelectedLang(e.target.value)}
          style={{ backgroundColor: '#141B2D', border: '1px solid #24324D', borderRadius: 8, padding: 12, color: '#FFFFFF', fontSize: 14 }}
        >
          <option value="all">All Languages</option>
          <option value="en">English</option>
          <option value="sw">Kiswahili</option>
        </select>
      </div>

      <section style={{ marginBottom: 40 }}>
        <h2 style={{ fontSize: 20, fontWeight: 700, color: '#CCFF00', marginBottom: 16 }}>⚡ Vibe Rising</h2>
        {loading ? (
          <div style={{ height: 100, backgroundColor: '#141B2D', borderRadius: 12, display: 'flex', alignItems: 'center', padding: 16 }}>
            <div style={{ width: '100%', height: 16, backgroundColor: '#24324D', borderRadius: 4 }} />
          </div>
        ) : (
          trending.map(story => (
            <StoryFeedCard key={story.id} story={story} />
          ))
        )}
      </section>

      <section>
        <h2 style={{ fontSize: 20, fontWeight: 700, marginBottom: 16 }}>Explore Feed</h2>
        {loading ? (
          <div style={{ display: 'flex', flexDirection: 'column', gap: 16 }}>
            {[1, 2, 3].map(i => (
              <div key={i} style={{ height: 120, backgroundColor: '#141B2D', borderRadius: 12, padding: 16, display: 'flex', flexDirection: 'column', gap: 12 }}>
                <div style={{ width: '40%', height: 16, backgroundColor: '#24324D', borderRadius: 4 }} />
                <div style={{ width: '80%', height: 12, backgroundColor: '#24324D', borderRadius: 4 }} />
                <div style={{ width: '20%', height: 12, backgroundColor: '#24324D', borderRadius: 4 }} />
              </div>
            ))}
          </div>
        ) : filteredStories.length === 0 ? (
          <div style={{ textAlign: 'center', padding: 48, backgroundColor: '#141B2D', borderRadius: 12, border: '1px dashed #24324D' }}>
            <p style={{ color: '#888899', fontSize: 16 }}>No stories found matching your selection.</p>
          </div>
        ) : (
          <div style={{ display: 'flex', flexDirection: 'column', gap: 16 }}>
            {filteredStories.map(story => (
              <StoryFeedCard key={story.id} story={story} />
            ))}
          </div>
        )}
      </section>

      <button
        onClick={() => router.push('/global/create/story')}
        style={{
          position: 'fixed',
          bottom: 24,
          right: 20,
          zIndex: 200,
          backgroundColor: '#CCFF00',
          color: '#090D16',
          borderRadius: 28,
          border: 'none',
          paddingTop: 14,
          paddingBottom: 14,
          paddingLeft: 20,
          paddingRight: 20,
          fontSize: 14,
          fontWeight: 900,
          boxShadow: '0 4px 20px rgba(204,255,0,0.3)',
          cursor: 'pointer',
        }}
      >
        ✏️ Write Story
      </button>

    </div>
  )
}
