  "worked_examples": [
    {
      "number": 1,
      "title": "Understand common-sized parts",
      "question": "1/2 + 1/3",
      "steps": [
        "Find the LCM of 2 and 3: 6.",
        "1/2 = 3/6; 1/3 = 2/6.",
        "Add 3/6 + 2/6 = 5/6."
      ],
      "answer": "5/6",
      "feedback": "Five of six equal pieces; the sum is less than one and bigger than either starting fraction."
    },
    {
      "number": 2,
      "title": "Convert both fractions",
      "question": "3/4 + 1/6",
      "steps": [
        "LCM(4,6)=12.",
        "3/4 = 9/12; 1/6 = 2/12.",
        "9/12 + 2/12 = 11/12."
      ],
      "answer": "11/12",
      "feedback": "Eleven twelfths is greater than three quarters and less than a whole."
    },
    {
      "number": 3,
      "title": "Convert only the needed fraction",
      "question": "3/8 + 1/4",
      "steps": [
        "LCM(8,4)=8.",
        "1/4 = 2/8, so 3/8 can stay as it is.",
        "3/8 + 2/8 = 5/8."
      ],
      "answer": "5/8",
      "feedback": "Avoid unnecessary multiplication when a denominator already fits."
    },
    {
      "number": 4,
      "title": "More demanding denominators",
      "question": "5/12 + 1/8",
      "steps": [
        "LCM(12,8)=24.",
        "5/12 = 10/24; 1/8 = 3/24.",
        "10/24 + 3/24 = 13/24."
      ],
      "answer": "13/24",
      "feedback": "Both numerator and denominator are already coprime, so 13/24 is simplest."
    },
    {
      "number": 5,
      "title": "Simplifying correctly",
      "question": "1/2 + 3/10",
      "steps": [
        "LCM(2,10)=10.",
        "1/2 = 5/10.",
        "5/10 + 3/10 = 8/10; divide top and bottom by 2."
      ],
      "answer": "4/5",
      "feedback": "8/10 and 4/5 are equal portions of the same whole."
    },
    {
      "number": 6,
      "title": "A total larger than one",
      "question": "2/3 + 5/6",
      "steps": [
        "LCM(3,6)=6.",
        "2/3 = 4/6.",
        "4/6 + 5/6 = 9/6 = 1 3/6 = 1 1/2."
      ],
      "answer": "1 1/2",
      "feedback": "One whole uses 6/6, and the remaining 3/6 is half a whole."
    },
    {
      "number": 7,
      "title": "Interpret a garden problem",
      "question": "2/5 + 1/4 of the same garden",
      "steps": [
        "Both sections are non-overlapping parts of the same whole.",
        "LCM(5,4)=20; 2/5=8/20 and 1/4=5/20.",
        "8/20 + 5/20 = 13/20."
      ],
      "answer": "13/20 of the garden",
      "feedback": "The wording matters: the areas must not overlap and use the same whole."
    },
    {
      "number": 8,
      "title": "Diagnose a common error",
      "question": "1/2 + 1/3 = 2/5 (incorrect)",
      "steps": [
        "Two fifths is smaller than one half, so adding a positive fraction could not give this.",
        "Change to equal-sized sixths: 1/2=3/6 and 1/3=2/6.",
        "3/6+2/6 = 5/6."
      ],
      "answer": "5/6",
      "feedback": "The incorrect rule adds denominators; do not add different-sized parts without converting them."
    }
  ],
